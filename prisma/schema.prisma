// منصة القرآن الكريم - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookmarks    Bookmark[]
  notes        Note[]
  readingLog   ReadingLog[]
  preferences  UserPreference?
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  surah     Int
  verse     Int
  text      String   @db.Text
  reference String
  color     String?  @default("gold")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surah, verse])
  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  surah     Int
  verse     Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([surah, verse])
}

model ReadingLog {
  id        String   @id @default(cuid())
  userId    String
  surah     Int
  verse     Int?
  duration  Int      @default(0) // ثوان
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  theme           String   @default("light") // light | dark | sepia
  fontFamily      String   @default("amiri")
  fontSize        Float    @default(1.7)
  reciter         String   @default("Alafasy_128kbps")
  defaultTafsir   String   @default("muyassar")
  defaultTrans    String   @default("en.sahih")
  showTranslation Boolean  @default(false)
  readMode        String   @default("page") // page | list

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
